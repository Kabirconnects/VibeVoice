# VibeVoice Configuration
# Copy this file to .env and fill in your values.

# ─── Mode ─────────────────────────────────────────────────────────────────────
# "local"  → load the model weights from MODEL_PATH (default, original behavior)
# "api"    → send TTS requests to an online API (see provider settings below)
VIBEVOICE_MODE=local

# ─── Local model settings (used when VIBEVOICE_MODE=local) ────────────────────
# Path to a local HuggingFace model directory or a HF repo-id.
MODEL_PATH=vibevoice/VibeVoice-1.5B

# ─── API provider (used when VIBEVOICE_MODE=api) ──────────────────────────────
# Which provider to use. Options: openai | google | elevenlabs | gemini
API_PROVIDER=openai

# Your API key for the chosen provider.
API_KEY=your-key-here

# (Optional) Request timeout in seconds.
API_TIMEOUT=60

# Multi-speaker: comma-separated list of voices (one per speaker, in order).
#   Example:  API_VOICES=alloy,echo,fable,onyx
# If omitted, all speakers share the single API_VOICE / default voice.
API_VOICES=


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER: openai   (also works for Azure OpenAI and any OpenAI-compatible API)
# ══════════════════════════════════════════════════════════════════════════════
# API_PROVIDER=openai
#
# Endpoint base URL:
#   OpenAI:       https://api.openai.com/v1
#   Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOY
#   Any compatible provider: paste their base URL here
# API_BASE_URL=https://api.openai.com/v1
#
# Model name:
#   tts-1       (faster, lower quality)
#   tts-1-hd    (slower, higher quality)
# API_MODEL=tts-1
#
# Voice name (OpenAI built-in voices):
#   alloy | echo | fable | onyx | nova | shimmer
# API_VOICE=alloy
#
# Multi-speaker: one voice per speaker, in order (e.g. 2 speakers → 2 voices):
# API_VOICES=alloy,echo,fable,onyx
#
# Response audio format:
#   mp3 | opus | aac | flac | wav | pcm
# API_AUDIO_FORMAT=wav


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER: google   (Google Cloud Text-to-Speech)
# ══════════════════════════════════════════════════════════════════════════════
# API_PROVIDER=google
#
# Your Google Cloud API key (enable "Cloud Text-to-Speech API" in Google Console)
# API_KEY=your-google-cloud-api-key
#
# Voice name — see full list at:
#   https://cloud.google.com/text-to-speech/docs/voices
# Examples:
#   en-US-Neural2-D  (male, Neural2)
#   en-US-Neural2-F  (female, Neural2)
#   en-GB-Wavenet-B  (male, UK, WaveNet)
#   en-US-Studio-O   (female, Studio — highest quality)
# API_MODEL=en-US-Neural2-D
#
# Speaking rate as a float — 1.0 = normal, 0.5 = half speed, 2.0 = double
# API_VOICE=1.0
#
# Multi-speaker: one Cloud TTS voice name per speaker (in order):
# API_VOICES=en-US-Neural2-D,en-US-Neural2-F,en-GB-Wavenet-B
#
# Audio encoding:
#   LINEAR16  (WAV, best quality — recommended)
#   MP3
#   OGG_OPUS
# API_AUDIO_FORMAT=LINEAR16


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER: elevenlabs   (ElevenLabs TTS)
# ══════════════════════════════════════════════════════════════════════════════
# API_PROVIDER=elevenlabs
#
# Your ElevenLabs API key
# API_KEY=your-elevenlabs-api-key
#
# Voice ID (NOT the voice name — copy the ID from the ElevenLabs website or API)
#   GET https://api.elevenlabs.io/v1/voices  to list your available voice IDs
# API_MODEL=21m00Tcm4TlvDq8ikWAM
#
# ElevenLabs model ID (controls quality/language):
#   eleven_multilingual_v2   (best quality, multilingual — recommended)
#   eleven_turbo_v2_5        (fastest, English only)
#   eleven_flash_v2_5        (ultra-low latency)
# API_VOICE=eleven_multilingual_v2
#
# Multi-speaker: one ElevenLabs VOICE ID per speaker (in order):
# API_VOICES=VOICE_ID_1,VOICE_ID_2,VOICE_ID_3
#
# Output audio format:
#   pcm_24000      (raw PCM 24kHz — best quality, no container overhead)
#   mp3_44100_128  (MP3 44.1kHz 128kbps)
#   mp3_44100_64
# API_AUDIO_FORMAT=pcm_24000


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER: gemini   (Google AI Studio / Gemini TTS)
# ══════════════════════════════════════════════════════════════════════════════
# API_PROVIDER=gemini
#
# Your Google AI Studio API key (starts with AQ. or AIza...)
#   Get one at https://aistudio.google.com/apikey
# API_KEY=your-google-ai-studio-api-key
#
# Gemini TTS model:
#   gemini-2.5-flash-preview-tts   (default, recommended)
#   gemini-2.5-pro-preview-tts     (higher quality, slower)
# API_MODEL=gemini-2.5-flash-preview-tts
#
# Voice name (Gemini prebuilt voices):
#   Aoede | Charon | Fenrir | Kore | Puck
#   | Achernar | Achird | Algenib | Algieba | Alnilam
# full list: https://ai.google.dev/gemini-api/docs/speech-generation
# API_VOICE=Kore
#
# Multi-speaker: one voice per speaker, in order (e.g. 2 speakers → 2 voices):
# API_VOICES=Kore,Puck,Charon,Aoede
#
# (Optional) Request timeout in seconds.
# API_TIMEOUT=120
